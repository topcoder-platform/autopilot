FROM maven:3.9.9-amazoncorretto-23-debian

ENV JAVA_OPTS="-Xms4G -Xmx4G -XX:MaxPermSize=512M -server"
ENV TZ=America/Indiana/Indianapolis

RUN mkdir -p /opt/autopilot
WORKDIR /opt/autopilot

Add ./target/auto-pilot-1.0-SNAPSHOT-spring-boot.jar /opt/autopilot/
Add ./xml_phase_template.xsd /opt/autopilot/
Add ./target/templates /opt/autopilot/templates/
ADD ./rund /opt/autopilot/
CMD ./rund
